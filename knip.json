{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route,template,default}.{ts,tsx}",
    "scripts/**/*.{js,mjs,ts}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{js,mjs,ts}"],
  "ignoreDependencies": ["@tailwindcss/turbopack", "tailwindcss"],
  "exclude": [
    "exports",
    "types",
    "nsExports",
    "nsTypes",
    "enumMembers",
    "duplicates",
    "catalog"
  ]
}
