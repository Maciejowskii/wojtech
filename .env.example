# Public site URL (sitemap, canonicals)
NEXT_PUBLIC_SITE_URL=https://woj-tech.pl

# Analytics / SEO verification (optional)
# GA4 Measurement ID — loads only after cookie consent
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML tag content (meta verification)
NEXT_PUBLIC_GSC_VERIFICATION=
# Ahrefs site verification token
NEXT_PUBLIC_AHREFS_SITE_VERIFICATION=

# Admin panel (/admin) — change these in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=long-random-string
